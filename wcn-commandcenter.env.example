# wcn-commandcenter — runtime config. Copy to wcn-commandcenter.env (gitignored) on the Pi.
# Read by the systemd --user unit; restart it after edits:
#   systemctl --user restart wcn-commandcenter

# Jellyfin (Dashboard → API Keys). Lights up now-playing / recently-added on the pulse card.
#JELLYFIN_URL=http://192.168.1.118:8096
#JELLYFIN_TOKEN=

# PhotoPrism. Either a bearer token / access token…
#PHOTOPRISM_URL=http://192.168.1.118:2342
#PHOTOPRISM_TOKEN=
# …or an app password used as a login (Settings → Account → Apps and Devices):
#PHOTOPRISM_USER=
#PHOTOPRISM_PASS=
# PhotoPrism search filter for the random batch. Examples:
#   quality:3 type:image public:true geo:true   (default — decent, non-private, geotagged stills;
#                                                geo:true is what keeps screenshots off the TV)
#   favorite:true type:image                (favorites only)
#   album:<uid> type:image                  (one album)
#PHOTOPRISM_QUERY=quality:3 type:image public:true geo:true
#PHOTOPRISM_BATCH=30

# MediaCMS studio (source of the gallery reel)
#MEDIACMS_BASE=http://192.168.1.118
#MEDIACMS_PLAYLIST=4cUEWvXJk
#WCN_CC_VIDEO_HEIGHT=720

# Kiosk
#WCN_CC_OUTPUT=HDMI-A-2
#WCN_CC_MODE=1920x1080@60
